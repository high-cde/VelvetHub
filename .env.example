# Database (MySQL) — run `pnpm db:push` to apply migrations
DATABASE_URL=******localhost:3306/velvethub

# Secret used to sign session JWTs. REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional: openId of the account that gets the admin role (email accounts use local:<hash>)
OWNER_OPEN_ID=

# Optional legacy OAuth portal (no longer needed for email/password login)
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# OAUTH_SERVER_URL=

NODE_ENV=development
PORT=3000

# Integrations — see .env.hybrid.example

# Client build only: origin of the API server (e.g. https://api.example.com) when the
# frontend is hosted separately (GitHub Pages). Leave empty when served by this server.
# The API server must allow that origin with credentials (CORS) and use SameSite=None cookies.
# VITE_API_URL=
# Server: comma-separated frontend origins allowed to call /api (e.g. https://high-cde.github.io)
# CORS_ORIGINS=
