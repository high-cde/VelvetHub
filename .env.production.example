# Copia in /opt/velvethub/.env (non versionare). chmod 600.
NODE_ENV=production
# Porta interna, diversa da quella di x-zdos
PORT=3100
DATABASE_URL=******127.0.0.1:3306/velvethub
# Genera con: openssl rand -hex 48
JWT_SECRET=
# Opzionale: openId dell'admin
OWNER_OPEN_ID=
# Opzionale: dirette
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
