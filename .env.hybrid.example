# First-party live video — obtain from LiveKit Cloud or self-hosted LiveKit
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# Existing analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Email/password auth requires these two (see .env.example)
DATABASE_URL=
JWT_SECRET=
# Existing app secrets remain required where applicable
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
